  "cards": [
    {
      "dot": "emerald",
      "title": "Hot path",
      "items": [
        "Beads history is extracted per time window and written once as Parquet",
        "Staging views read Parquet in place; marts are written back as Parquet",
        "Marts are the only tables people query"
      ]
    },
    {
      "dot": "cyan",
      "title": "Idempotency",
      "items": [
        "File path is derived from the window, never the clock",
        "Re-running a window overwrites its file",
        "Lookback re-extracts trailing windows to absorb late data"
      ]
    },
    {
      "dot": "amber",
      "title": "Phase 1 mechanics",
      "items": [
        "Go transforms read mart Parquet directly with parquet-go",
        "Every reader runs its own DuckDB over Parquet, so nobody touches dbt's writer file",
        "dbt declares derived as a source so lineage and freshness stay honest"
      ]
    }
  ]
