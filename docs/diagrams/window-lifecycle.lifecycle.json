  "cards": [
    {
      "dot": "emerald",
      "title": "Why re-entry is safe",
      "items": [
        "Every path back into Due lands on the same file path, and the write overwrites it",
        "Lookback re-enters trailing windows; backfill re-enters any range. No cleanup step"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure is scoped to one window",
      "items": [
        "The retry leaves the rail and rejoins it; only that window stops, its siblings land",
        "WriteWindow and DeleteSpool retry the same way and are not drawn"
