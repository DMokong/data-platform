  "cards": [
    {
      "dot": "emerald",
      "title": "Why re-entry is safe",
      "items": [
        "Every path back into Due lands on the same deterministic file path, and the write overwrites it",
        "Lookback re-enters trailing windows every run; backfill re-enters an arbitrary range, with no cleanup step"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure is scoped to one window",
      "items": [
        "Temporal retries in place; the state does not advance until the activity succeeds, and an exhausted budget stops that window alone",
        "An orphaned spool costs disk, never correctness: the next run rewrites the same target"
      ]
    }
  ]
