  "cards": [
    {
      "dot": "rose",
      "title": "The claim-check",
      "items": [
        "The largest hourly window is about 6 MB, against Temporal's 2 MB payload limit",
        "Rows go to a spool file; only a reference travels through workflow history"
      ]
    },
    {
      "dot": "cyan",
      "title": "Why a child per window",
      "items": [
        "A window is the unit of retry: one poisoned hour fails alone and its siblings land",
        "Workflow ids derive from source and window, so a re-trigger is a no-op"
      ]
    },
    {
      "dot": "emerald",
      "title": "What Temporal buys",
      "items": [
        "Durable state and per-activity retries instead of a bespoke loop in the Runner",
        "A Schedule with an overlap policy replaces the ticker the design first called for"
      ]
    }
  ]
