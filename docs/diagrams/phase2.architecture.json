  "cards": [
    {
      "dot": "cyan",
      "title": "Stateless compute (EKS)",
      "items": [
        "Go workers, dbt-duckdb workers and BI are Deployments; delete any pod and Temporal reschedules the activity",
        "Go binaries stay CGO-free: they write Parquet and read marts over Postgres wire",
        "All pods export OTLP to Grafana Cloud (not drawn)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two Postgres roles",
      "items": [
        "RDS Postgres holds the DuckLake catalog and Temporal persistence: plain tables, managed, Multi-AZ",
        "The serving Postgres runs pg_duckdb, which RDS does not offer, so it is a pod; it holds no durable state",
        "S3 is the ground truth; concurrent dbt pods coordinate through catalog transactions"
      ]
    },
    {
      "dot": "rose",
      "title": "Front door and escape hatch",
      "items": [
        "PgBouncer and Postgres roles give auth, RLS, audit and a connection cap",
        "Every BI tool connects as if to plain Postgres",
        "Redshift Spectrum can read the same bronze bucket if the named triggers are hit"
      ]
    }
  ]
