  "cards": [
    {
      "dot": "cyan",
      "title": "Why two passes",
      "items": [
        "dbt cannot see inside a Go binary, so the Go step sits between two builds; tags are the seam",
        "dbt build constructs each node then tests it immediately, and halts the pass on the first failure"
      ]
    },
    {
      "dot": "amber",
      "title": "The selection trap",
      "items": [
        "Default eager selection drags the post_go relationships test into pass 1, before its mart exists",
        "flags.indirect_selection: buildable runs a test only once all of its parents are in the build"
      ]
    }
  ]
