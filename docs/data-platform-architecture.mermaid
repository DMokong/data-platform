flowchart TB
    subgraph SRC["Sources"]
        S1["Beads tracker — Dolt, MySQL wire<br/>events (hourly windows), issues (daily snapshot),<br/>dolt_history_issues, comments, deps, labels"]
        S2["Later: legacy claw-* JSONL backfill,<br/>plant sensors (no device yet), spending"]
    end

    subgraph GO["Go ingestion service"]
        F["Fetcher (one per source)<br/>source protocol, rate limits, never transforms"]
        W["Writer (shared)<br/>one Parquet file per source per window<br/>path = f(window); overwrite on re-run<br/>stamps _extracted_at, _window_start, _window_end, _source_file"]
        R["Runner<br/>window / cadence / lookback per source<br/>backfill --from --to"]
        F --> W
        R -.-> F
        R -.-> W
    end

    subgraph BRONZE["Bronze — Parquet, immutable, replayable (the only durable thing)"]
        P["bronze/raw/&lt;source&gt;/&lt;table&gt;/dt=…/hh=….parquet"]
        D["bronze/derived/&lt;transform&gt;/dt=…/hh=….parquet<br/>written by Go transforms via the same Writer"]
        C["Compaction (later)<br/>hourly files → one daily file"]
        P -.-> C
    end

    subgraph WH["Warehouse — Phase 1 DuckDB (1 writer OR n readers) · Phase 2 Redshift or self-hosted DuckDB lakehouse"]
        RAW["raw + derived as EXTERNAL tables<br/>no load step; declared in sources.yml"]
        STG["staging — views<br/>casts, renames, UTC → local, explicit columns<br/>no joins, no business logic"]
        MART["marts — tables<br/>SCD2 issue history, cycle time, throughput,<br/>agent activity, drift"]
        RAW --> STG --> MART
    end

    subgraph DBT["dbt Core"]
        SRCYML["sources.yml<br/>external_location → bronze paths<br/>freshness on _extracted_at"]
        TESTS["dbt build: build each model, test it, halt on failure<br/>unique / not_null on staging keys<br/>accepted_values, relationships<br/>freshness on RAW and derived"]
    end

    subgraph GOX["Go transforms (optional)"]
        GT["contract: inputs, one output, window, tests<br/>read staging/marts as Parquet (or Postgres wire in phase 2)<br/>row logic, free-text parsing, model calls<br/>never an embedded DuckDB"]
    end

    ORCH["Go orchestrator on Temporal<br/>MaterialiseWindow(source, window): Fetcher + Writer as Activities, Schedule replaces ticker<br/>BuildMarts(window): dbt build tag:pre_go → Go transforms → dbt build tag:post_go<br/>Phase 1: temporal server start-dev · Phase 2: Helm on EKS, workers as Deployments"]

    VIZ["Phase 1: DuckDB UI, read-only, between builds<br/>Phase 2: concurrent-read BI over Postgres wire (pg_duckdb)<br/>or native Redshift drivers"]

    OTEL["OTel → Grafana Cloud<br/>rows, bytes, duration, outcome per workflow<br/>dbt run_results.json"]

    S1 --> F
    S2 --> F
    W --> P
    P -->|"read in place"| RAW
    D -->|"read in place"| RAW
    SRCYML -.-> RAW
    TESTS -.-> RAW
    TESTS -.-> STG
    TESTS -.-> MART
    STG --> GT
    MART --> GT
    GT --> D
    ORCH -->|"schedules"| GO
    ORCH -->|"shells out"| DBT
    ORCH -->|"activity"| GOX
    ORCH -.-> OTEL
    MART --> VIZ

    subgraph PHASES["Deployment phases"]
        PH1["Phase 1 — learning<br/>local disk · plain Parquet · DuckDB<br/>Temporal dev server · single Go process · DuckDB UI"]
        PH2["Phase 2 — EKS<br/>S3 · DuckLake or Iceberg · Glue or Postgres catalog<br/>Redshift OR self-hosted DuckDB lakehouse<br/>Temporal via Helm · Go workers as Deployments · BI over Postgres wire"]
        PH1 --> PH2
    end
